<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/temanku_voice_widget_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="14dp"
    android:paddingEnd="14dp"
    android:paddingBottom="14dp">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="2"
        android:text="Tambah Transaksi Kamu"
        android:textColor="#1F1A17"
        android:textSize="15sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/widget_camera"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="12dp"
        android:background="@android:color/transparent"
        android:contentDescription="Camera transaction"
        android:padding="10dp"
        android:src="@android:drawable/ic_menu_camera"
        android:tint="#1F1A17" />

    <ImageView
        android:id="@+id/widget_mic"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="8dp"
        android:background="@android:color/transparent"
        android:contentDescription="Voice transaction"
        android:padding="8dp"
        android:src="@android:drawable/ic_btn_speak_now"
        android:tint="#1F1A17" />

</LinearLayout>
